# Server Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/swayam?schema=public"

# Security
JWT_SECRET=super_secret_key_change_in_production
JWT_EXPIRATION=1h
REFRESH_TOKEN_SECRET=super_secret_refresh_key_change_in_production
REFRESH_TOKEN_EXPIRATION=7d
CORS_ORIGIN=*

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Redis (for Background Jobs & Caching)
REDIS_HOST=localhost
REDIS_PORT=6379

# Third Party Services (Mock / Testing)
EMAIL_SERVICE_API_KEY=your_email_api_key
WHATSAPP_SERVICE_API_KEY=your_whatsapp_api_key
LLM_PROVIDER_API_KEY=your_llm_api_key
