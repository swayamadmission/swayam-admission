# ==============================================================================
# SWAYAM ADMISSION BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development or populate in Render Environment Variables.
# NEVER commit populated production secrets or passwords to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED FOR STARTUP (Mandatory)
# ------------------------------------------------------------------------------
# Runtime environment ('development' | 'production' | 'test')
NODE_ENV=production

# Port supplied automatically by Render Web Service (e.g., 10000 or 3000)
PORT=3000

# Hosted PostgreSQL connection string (Prisma pooled or direct URL)
# Example for Render PostgreSQL / Supabase / Neon:
# DATABASE_URL="postgresql://user:password@host.render.com:5432/swayam_db?sslmode=require"
DATABASE_URL="postgresql://user:password@localhost:5432/swayam_admission?schema=public"

# Primary secret for signing JWT access tokens (min 32 random characters in prod)
JWT_SECRET=replace_with_secure_random_jwt_secret_min_32_chars

# Secret for signing and validating refresh tokens (must differ from JWT_SECRET)
REFRESH_TOKEN_SECRET=replace_with_secure_random_refresh_token_secret_min_32_chars

# Optional JWT access token expiration override (default: 15m)
JWT_EXPIRATION=15m

# Optional Refresh token expiration override (default: 7d)
REFRESH_TOKEN_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND ACCESS (Mandatory for frontend connectivity)
# ------------------------------------------------------------------------------
# Active Testing Domains (Vercel Preview):
# - Admin & ERP Portal: https://swayam-admission-eg2x.vercel.app
# - Student & Public Website: https://swayam-admission.vercel.app
#
# Authoritative allowed CORS origins (exact HTTPS origins without trailing slashes):
CORS_ORIGIN=https://swayam-admission-eg2x.vercel.app,https://swayam-admission.vercel.app

# Student / Public Website URL (verification links, student password reset, public SEO):
FRONTEND_URL=https://swayam-admission.vercel.app
FRONTEND_USER_URL=https://swayam-admission.vercel.app

# Administration & ERP Portal URLs (employee activation, admin password reset):
ADMIN_URL=https://swayam-admission-eg2x.vercel.app
ADMIN_PORTAL_URL=https://swayam-admission-eg2x.vercel.app
ERP_PORTAL_URL=https://swayam-admission-eg2x.vercel.app
PORTAL_URL=https://swayam-admission-eg2x.vercel.app

# Future Custom Domains (Documented for seamless migration - DO NOT ACTIVATE YET):
# - Public website and student frontend: https://swayamadmission.com
# - Admin portal: https://admin.swayamadmission.com
# - Employee/ERP portal: https://erp.swayamadmission.com

# Security / Developer settings
# In production, leave false or unset so plaintext OTPs (devOtp/devCode) are never returned in HTTP responses
ENABLE_DEV_OTP=false

# ------------------------------------------------------------------------------
# 3. UPLOAD & DOCUMENT STORAGE
# ------------------------------------------------------------------------------
# Storage provider ('LOCAL')
STORAGE_PROVIDER=LOCAL

# Optional custom directory for uploads (e.g., when mounting a Render Persistent Disk)
# Default if unset: ./uploads within the application working directory
# UPLOAD_DIR=/var/data/uploads

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (Required for application fees / study material purchases)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_swayam_admission_2026
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# ------------------------------------------------------------------------------
# 5. AI COUNSELING & LLM (Optional - internal fallback heuristic engine used if unset)
# ------------------------------------------------------------------------------
# Google Gemini API Key (recommended)
GEMINI_API_KEY=
# OpenAI API Key (optional alternative)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 6. REDIS & ASYNC QUEUES (Optional - BullMQ queues only initialize if configured)
# ------------------------------------------------------------------------------
REDIS_ENABLED=false
# Full Redis URL (e.g. from Render Redis or Redis Cloud: rediss://default:pwd@host:6379)
REDIS_URL=
# Or discrete connection parameters:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 7. EMAIL, SMS & WHATSAPP GATEWAYS
# ------------------------------------------------------------------------------
# Transactional Email Provider: 'SES' | 'SENDGRID' | 'GMAIL' | 'SMTP' (default: SMTP)
EMAIL_PROVIDER=SMTP

# Port & Encryption Rules:
# - Port 587: SMTP_PORT=587 and SMTP_SECURE=false (Standard STARTTLS - Recommended for SES, SendGrid, Gmail)
# - Port 465: SMTP_PORT=465 and SMTP_SECURE=true (Direct SSL/TLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Provider Credentials:
# For Amazon SES:
#   SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=AKIAEXAMPLEUSERNAME
#   SMTP_PASSWORD=BGEXAMPLEPASSWORD
#
# For SendGrid:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=apikey
#   SMTP_PASSWORD=SG.EXAMPLE_API_KEY
#
# For Testing via Gmail SMTP:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=swayamadmissions@gmail.com
#   SMTP_PASSWORD=your_16_digit_gmail_app_password
#
# Note: Both SMTP_PASSWORD and SMTP_PASS are accepted interchangeably. Whitespace is stripped automatically.
SMTP_USER=swayamadmissions@gmail.com
SMTP_PASSWORD=your_16_digit_gmail_app_password
SMTP_PASS=your_16_digit_gmail_app_password

# Sender Identity:
# Current active testing sender: swayamadmissions@gmail.com
# Future custom domain sender (post domain purchase & verification): admin@swayamadmission.com
SMTP_FROM_EMAIL=swayamadmissions@gmail.com
SMTP_FROM_NAME="Swayam Admission"

# Email Provider Delivery Webhook Secrets (For validating callback signatures & anti-replay):
# - SendGrid Event Webhook callback: /v1/notifications/webhook/sendgrid
#   Provide either ECDSA Public Verification Key or HMAC Webhook Secret:
SENDGRID_WEBHOOK_VERIFICATION_KEY=
SENDGRID_WEBHOOK_SECRET=
# - Amazon SES via SNS callback: /v1/notifications/webhook/ses
NOTIFICATION_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API Configuration
# Get these credentials from Meta for Developers (developers.facebook.com) -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0
# Webhook verification token configured in Meta App Dashboard (for GET challenge verification)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=swayam_meta_verify_token_change_in_prod
# App Secret from Meta App Dashboard (used for X-Hub-Signature-256 HMAC payload verification)
WHATSAPP_APP_SECRET=

# Fast2SMS Gateway Configuration
# Get API Key from Fast2SMS dashboard (fast2sms.com) -> Dev API
FAST2SMS_API_KEY=
# Route: 'q' (Quick SMS), 'dlt' (DLT Registered), or 'v3'
FAST2SMS_ROUTE=q
# Sender ID: 6-character sender ID registered with DLT (optional for quick route)
FAST2SMS_SENDER_ID=
# Optional shared webhook secret for Fast2SMS delivery receipt callback verification
FAST2SMS_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 8. GOOGLE OAUTH CONFIGURATION (Google Identity Services Web Client ID)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Web Client ID from Google Cloud Console (Credentials -> OAuth 2.0 Client IDs -> Web application)
# Must match VITE_GOOGLE_CLIENT_ID configured on the frontend (Vercel)
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id_here.apps.googleusercontent.com
