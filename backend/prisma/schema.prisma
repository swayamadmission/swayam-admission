model OtpVerification {
  id          String   @id @default(cuid())
  type        String   // 'MOBILE_LOGIN' | 'EMAIL_VERIFICATION'
  identifier  String   // Normalized E.164 mobile or normalized email
  otpHash     String   // Bcrypt/SHA-256 hash of 6-digit OTP
  expiresAt   DateTime
