  duration  String   @default("Session")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([isActive])
}

model Grievance {
  id           String    @id @default(cuid())
  complaintId  String    @unique
  userId       String
  category     String
  subject      String
  description  String    @db.Text
  status       String    @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | IN_PROGRESS | RESOLVED | REJECTED | CLOSED
  assignedToId String?
  response     String?   @db.Text
  resolution   String?   @db.Text
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  user         User      @relation("Grievance_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo   User?     @relation("Grievance_assignedToIdToUser", fields: [assignedToId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([complaintId])
  @@index([category])
}

model OtpConfiguration {
  id                  String   @id @default(cuid())
  channel             String   @unique // 'WHATSAPP' | 'EMAIL'
  enabled             Boolean  @default(false)
  provider            String?
  
  // Provider credentials
  apiKey              String?
  accountId           String?
  phoneNumberId       String?
  apiHost             String?
  apiPort             Int?
  apiUser             String?
  apiPassword         String?
  apiSecure           Boolean  @default(true)
  
  // Display Information
  fromName            String?
  fromEmail           String?
  templateName        String?
  templateLanguage    String?

  // Additional provider settings
  providerUrl         String?
  senderId            String?
  templateId          String?
  
  // Policies
  expirySeconds       Int      @default(300)
  maxAttempts         Int      @default(5)
  resendCooldownSec   Int      @default(30)
  rateLimitCount      Int      @default(10)
  rateLimitWindowSec  Int      @default(3600)
  
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}




model JobVacancy {
  id                  String             @id @default(cuid())
  vacancyCode         String?            @unique // e.g. SWY-VAC-00001
  title               String
  department          String
  designation         String
  employmentType      String             @default("FULL_TIME")
  location            String?
  workMode            String             @default("ONSITE") // ONSITE, HYBRID, REMOTE
  numberOfPositions   Int                @default(1)
  minimumQualification String?
  preferredQualification String?
  experience          String?
  requiredSkills      String[]           @default([])
  preferredSkills     String[]           @default([])
  salaryRange         String?
  salaryMin           Float?
  salaryMax           Float?
  salaryCurrency      String             @default("INR")
  jobDescription      String?            @db.Text
  responsibilities    String?            @db.Text
  educationRequirements String?          @db.Text
  experienceRequirements String?         @db.Text
  requiredDocuments   String[]           @default([]) // Configurable required docs
  applicationStartDate DateTime?
  applicationEndDate  DateTime?
  applicationDeadline DateTime?
  status              String             @default("DRAFT") // DRAFT, PUBLISHED, PAUSED, CLOSED, ARCHIVED
  priority            String?            // HIGH, MEDIUM, LOW
  interviewType       String?
  interviewMode       String?
  recruiterId         String?
  reportingManagerId  String?
  createdBy           String?
  updatedById         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  publishedAt         DateTime?
  closedAt            DateTime?
  archivedAt          DateTime?
  applications        JobApplication[]

  @@index([status])
  @@index([department])
  @@index([vacancyCode])
}

model JobApplication {
  id                  String             @id @default(cuid())
  applicationId       String             @unique // e.g., JOB-2026-000123
  vacancyId           String
  userId              String?
  firstName           String
  lastName            String?
  email               String
  mobile              String
  address             String?
  state               String?
  city                String?
  qualification       String?
  experience          String?
  previousOrganization String?
  currentDesignation  String?
  skills              String[]           @default([])
  expectedSalary      String?
  noticePeriod        String?
  linkedInUrl         String?
  portfolioUrl        String?
  coverLetter         String?            @db.Text
  additionalInfo      String?            @db.Text
  resumeUrl           String?
  resumeFileName      String?
  resumeFileSize      Int?
  resumeMimeType      String?
  recruiterId         String?
  assignedById        String?
  assignedAt          DateTime?
  internalNotes       String?            @db.Text
  rejectionReason     String?            @db.Text
  holdReason          String?            @db.Text
  isArchived          Boolean            @default(false)
  archivedAt          DateTime?
  statusHistory       Json?              @default("[]")
  timelineNotes       Json?              @default("[]")
  status              String             @default("APPLIED") // APPLIED, SHORTLISTED, INTERVIEW_SCHEDULED, INTERVIEW_COMPLETED, SELECTED, REJECTED, HOLD, etc.
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  vacancy             JobVacancy         @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  user                User?              @relation(fields: [userId], references: [id])
  documents           CandidateDocument[]
  interviews          Interview[]
  offer               Offer?
  onboarding          RecruitmentOnboarding?

  @@index([vacancyId])
  @@index([userId])
  @@index([email])
  @@index([status])
  @@index([recruiterId])
  @@index([isArchived])
}

model RecruitmentSetting {
  id                         String   @id @default("default_recruitment_setting")
  recruitmentEmail           String   @default("careers@swayamadmission.com")
  recruitmentDisplayName     String   @default("Swayam Admission Careers Team")
  replyToEmail               String?  @default("careers@swayamadmission.com")
  ccEmails                   String[] @default([])
  bccEmails                  String[] @default([])
  candidateAckEnabled        Boolean  @default(true)
  adminNotificationEnabled   Boolean  @default(true)
  resumeAttachmentEnabled    Boolean  @default(true)
  maxResumeSizeMB            Int      @default(10)
  allowedResumeFormats       String[] @default(["pdf", "doc", "docx"])
  applicationIdPrefix        String   @default("SWY-JOB-APP-")
  heroTitle                  String?  @default("Join Swayam Admission")
  heroSubtitle               String?  @default("Discover opportunities to build a rewarding career with us and help shape the future of education.")
  autoSendRejectionEmail     Boolean  @default(false)
  autoSendShortlistEmail     Boolean  @default(false)
  updatedById                String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @default(now()) @updatedAt
}

model CandidateDocument {
  id               String         @id @default(cuid())
  applicationId    String
  title            String         // e.g., Resume, Education Certificate
  fileUrl          String
  fileName         String
  isRequired       Boolean        @default(false)
  status           String         @default("PENDING") // PENDING, UNDER_REVIEW, VERIFIED, REJECTED, ACTION_REQUIRED
  verificationNotes String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  application      JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Interview {
  id               String               @id @default(cuid())
  applicationId    String
  interviewType    String               @default("ONLINE") // ONLINE, OFFLINE
  interviewDate    DateTime
  time             String?
  interviewerId    String?              // References User (Staff)
  meetingLink      String?
  location         String?
  instructions     String?              @db.Text
  status           String               @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, NO_SHOW
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt
  application      JobApplication       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer      User?                @relation("Interview_interviewerIdToUser", fields: [interviewerId], references: [id])
  evaluations      InterviewEvaluation[]

  @@index([applicationId])
  @@index([interviewerId])
}

model InterviewEvaluation {
  id                  String         @id @default(cuid())
  interviewId         String
  communicationScore  Int?
  technicalScore      Int?
  roleSkillsScore     Int?
  experienceScore     Int?
  overallAssessment   String?        @db.Text
  recommendation      String         // SELECT, REJECT, HOLD
  evaluatorId         String?        // References User (Staff)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now()) @updatedAt
  interview           Interview      @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  evaluator           User?          @relation("Evaluation_evaluatorIdToUser", fields: [evaluatorId], references: [id])

  @@index([interviewId])
}

model Offer {
  id               String         @id @default(cuid())
  offerCode        String?        // e.g. SWY-OFFER-2026-0001
  applicationId    String         @unique
  designation      String?
  department       String?
  employmentType   String?        @default("FULL_TIME")
  workMode         String?        @default("ONSITE")
  workLocation     String?
  reportingManager String?
  joiningDate      DateTime?
  salary           Float?
  salaryFrequency  String?        @default("ANNUAL")
  validUntil       DateTime?
  notes            String?        @db.Text
  terms            String?        @db.Text
  offerLetterUrl   String?
  status           String         @default("OFFER_SENT") // DRAFT, OFFER_SENT, OFFER_ACCEPTED, OFFER_DECLINED, WITHDRAWN, CANCELLED, EXPIRED
  issuedAt         DateTime       @default(now())
  sentAt           DateTime?
  acceptedAt       DateTime?
  declinedAt       DateTime?
  declinedReason   String?
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  application      JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  clearance        EmployeeClearance?

  @@index([status])
  @@index([offerCode])
}

model EmployeeClearance {
  id               String                   @id @default(cuid())
  offerId          String                   @unique
  userId           String?                  @unique // Linked to the newly generated User identity
  status           String                   @default("PENDING") // PENDING, IN_PROGRESS, VERIFIED, HR_CLEARED, FINAL_CLEARED, FAILED, ACTIVE, COMPLETED
  hrClearedAt      DateTime?
  hrClearedById    String?
  finalClearedAt   DateTime?
  finalClearedById String?
  notes            String?                  @db.Text
  failureReason    String?                  @db.Text
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @default(now()) @updatedAt
  offer            Offer                    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user             User?                    @relation("Clearance_userIdToUser", fields: [userId], references: [id])
  hrClearedBy      User?                    @relation("Clearance_hrClearedByIdToUser", fields: [hrClearedById], references: [id])
  finalClearedBy   User?                    @relation("Clearance_finalClearedByIdToUser", fields: [finalClearedById], references: [id])
  checklistItems   ClearanceChecklistItem[]

  @@index([status])
}

model ClearanceChecklistItem {
  id            String            @id @default(cuid())
  clearanceId   String
  itemKey       String            // IDENTITY_KYC, ADDRESS, EDUCATION, RESUME, EMPLOYMENT_BG, UPLOADED_DOCS, OFFER_VERIFICATION, FINAL_HR
  title         String
  status        String            @default("PENDING") // PENDING, IN_REVIEW, VERIFIED, FAILED, NOT_REQUIRED
  isRequired    Boolean           @default(true)
  reviewedById  String?
  reviewedAt    DateTime?
  remarks       String?           @db.Text
  failureReason String?           @db.Text
  documentUrl   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  clearance     EmployeeClearance @relation(fields: [clearanceId], references: [id], onDelete: Cascade)
  reviewedBy    User?             @relation(fields: [reviewedById], references: [id])

  @@index([clearanceId])
  @@index([itemKey])
}

model RecruitmentOnboarding {
  id               String         @id @default(cuid())
  applicationId    String         @unique
  employeeId       String         @unique // e.g. EMP-2026-0001
  userId           String?        @unique
  department       String
  designation      String
  reportingManager String?
  workLocation     String?
  workMode         String?        @default("ONSITE")
  employmentType   String?        @default("FULL_TIME")
  officialEmail    String?
  officialMobile   String?
  joiningDate      DateTime
  status           String         @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  notes            String?        @db.Text
  completedAt      DateTime?
  completedById    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  application      JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user             User?          @relation(fields: [userId], references: [id])
  completedBy      User?          @relation("OnboardingCompletedBy", fields: [completedById], references: [id])

  @@index([applicationId])
  @@index([employeeId])
  @@index([status])
}

model EmployeeRoleHistory {
  id                  String    @id @default(cuid())
  userId              String
  previousDepartment  String?
  previousDesignation String?
  previousRoleId      String?
  newDepartment       String?
  newDesignation      String?
  newRoleId           String?
  effectiveDate       DateTime  @default(now())
  changedById         String?
  reason              String?
  createdAt           DateTime  @default(now())
  user                User      @relation("History_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)
  changedBy           User?     @relation("History_changedByIdToUser", fields: [changedById], references: [id])
  previousRole        RoleEntity? @relation("History_previousRoleIdToRole", fields: [previousRoleId], references: [id])
  newRole             RoleEntity? @relation("History_newRoleIdToRole", fields: [newRoleId], references: [id])

  @@index([userId])
}

model AccessScope {
  id            String    @id @default(cuid())
  userId        String
  scopeType     String    // e.g., STATE, DISTRICT, DEPARTMENT, GLOBAL
  scopeValue    String    // e.g., "MH", "MUMBAI", "FINANCE"
  grantedById   String?
  createdAt     DateTime  @default(now())
  user          User      @relation("AccessScope_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy     User?     @relation("AccessScope_grantedByIdToUser", fields: [grantedById], references: [id])

  @@index([userId])
  @@index([scopeType, scopeValue])
}
