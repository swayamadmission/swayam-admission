generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AIAnalytics {
  id                       String         @id @default(cuid())
  userId                   String
  conversationId           String         @unique
  queryCategory            String?
  recommendationAccepted   Boolean        @default(false)
  studentSatisfactionScore Int?
  converted                Boolean        @default(false)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @default(now()) @updatedAt
  AIConversation           AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  User                     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIChunk {
  id                   String                 @id @default(cuid())
  documentId           String?
  content              String
  tokenCount           Int                    @default(0)
  chunkIndex           Int                    @default(0)
  category             String                 @default("GENERAL")
  source               String                 @default("INTERNAL_DB")
  metadata             Json?                  @default("{}")
  createdAt            DateTime               @default(now())
  document             AIKnowledgeDocument?   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  AIEmbeddingReference AIEmbeddingReference[]

  @@index([category])
  @@index([documentId])
}

model AIConversation {
  id                      String                    @id @default(cuid())
  userId                  String
  title                   String                    @default("Counseling Session")
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @default(now()) @updatedAt
  counselorId             String?
  estimatedCost           Float                     @default(0.0)
  isEscalated             Boolean                   @default(false)
  language                String?                   @default("en")
  lastIntent              String?
  leadId                  String?
  sentiment               String?                   @default("POSITIVE")
  summary                 String?
  totalTokens             Int                       @default(0)
  userRating              Int?
  AIAnalytics             AIAnalytics?
  user                    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  AIConversationMemory    AIConversationMemory[]
  AIConversationSentiment AIConversationSentiment[]
  AIConversationTag       AIConversationTag[]
  escalations             AIEscalation[]
  feedbacks               AIFeedback[]
  memory                  AIMemory?
  messages                AIMessage[]
  recommendations         AIRecommendation[]

  @@index([counselorId])
  @@index([leadId])
  @@index([userId])
}

model AIConversationMemory {
  id             String         @id @default(cuid())
  conversationId String
  key            String
  value          String
  category       String         @default("PREFERENCE")
  createdAt      DateTime       @default(now())
  AIConversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIConversationSentiment {
  id             String         @id @default(cuid())
  conversationId String
  sentimentScore Float          @default(0.8)
  buyingSignal   String         @default("HIGH")
  urgencyLevel   String         @default("IMMEDIATE")
  createdAt      DateTime       @default(now())
  AIConversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AIConversationSummary {
  id               String   @id @default(cuid())
  conversationId   String   @unique
  summaryText      String
  extractedIntents String[] @default([])
  actionItems      String[] @default([])
  keyPreferences   Json?    @default("{}")
  createdAt        DateTime @default(now())
}

model AIConversationTag {
  id             String         @id @default(cuid())
  conversationId String
  tagName        String
  createdAt      DateTime       @default(now())
  AIConversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIEmbeddingReference {
  id          String   @id @default(cuid())
  chunkId     String
  vectorModel String   @default("text-embedding-3-small")
  embedding   Json?
  dimensions  Int      @default(1536)
  createdAt   DateTime @default(now())
  AIChunk     AIChunk  @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([chunkId])
}

model AIEscalation {
  id                                  String          @id @default(cuid())
  conversationId                      String?
  userId                              String?
  leadId                              String?
  counselorId                         String?
  reason                              String          @default("LOW_CONFIDENCE")
  status                              String          @default("PENDING")
  summary                             String?
  createdAt                           DateTime        @default(now())
  AIConversation                      AIConversation? @relation(fields: [conversationId], references: [id])
  User_AIEscalation_counselorIdToUser User?           @relation("AIEscalation_counselorIdToUser", fields: [counselorId], references: [id])
  User_AIEscalation_userIdToUser      User?           @relation("AIEscalation_userIdToUser", fields: [userId], references: [id])

  @@index([counselorId])
  @@index([status])
}

model AIFeedback {
  id             String          @id @default(cuid())
  conversationId String?
  messageId      String?         @unique
  userId         String?
  rating         Int             @default(5)
  feedbackText   String?
  isCorrected    Boolean         @default(false)
  correctedBy    String?
  correctedText  String?
  status         String          @default("PENDING")
  createdAt      DateTime        @default(now())
  AIConversation AIConversation? @relation(fields: [conversationId], references: [id])
  AIMessage      AIMessage?      @relation(fields: [messageId], references: [id])
  User           User?           @relation(fields: [userId], references: [id])

  @@index([rating])
  @@index([status])
}

model AIIntent {
  id             String   @id @default(cuid())
  conversationId String?
  intentType     String   @default("COLLEGE_INQUIRY")
  confidence     Float    @default(0.9)
  extractedData  Json?    @default("{}")
  createdAt      DateTime @default(now())

  @@index([intentType])
}

model AIKnowledgeCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?  @default("Folder")
  docCount    Int      @default(0)
  createdAt   DateTime @default(now())
}

model AIKnowledgeDocument {
  id         String    @id @default(cuid())
  title      String
  category   String    @default("GENERAL")
  fileType   String    @default("PDF")
  fileUrl    String?
  sourceUrl  String?
  author     String?
  fileSize   Int?
  chunkCount Int       @default(0)
  status     String    @default("PROCESSED")
  isApproved Boolean   @default(true)
  metadata   Json?     @default("{}")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  chunks     AIChunk[]

  @@index([category])
  @@index([status])
}

model AILeadScore {
  id                    String   @id @default(cuid())
  leadId                String   @unique
  score                 Int      @default(65)
  qualificationStage    String   @default("WARM")
  intentLevel           Float    @default(0.7)
  budgetMatch           Boolean  @default(true)
  academicEligible      Boolean  @default(true)
  engagementScore       Int      @default(70)
  conversionProbability Float    @default(65.0)
  recommendedNextAction String   @default("SCHEDULE_COUNSELOR_CALL")
  lastCalculatedAt      DateTime @default(now())
  Lead                  Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([qualificationStage])
  @@index([score])
}

model AIMemory {
  id               String         @id @default(cuid())
  conversationId   String         @unique
  contextState     Json?
  studentDecisions Json?
  followUpTopics   String[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  AIConversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model AIMessage {
  id               String         @id @default(cuid())
  conversationId   String
  role             AIMessageRole
  content          String
  createdAt        DateTime       @default(now())
  completionTokens Int?           @default(0)
  confidenceScore  Float?         @default(0.95)
  modelUsed        String?
  promptTokens     Int?           @default(0)
  provider         String?
  retrievedContext Json?
  AIFeedback       AIFeedback?
  AIConversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AIModelConfiguration {
  id              String   @id @default(cuid())
  provider        String
  modelName       String   @unique
  displayName     String
  contextWindow   Int      @default(128000)
  costPer1kTokens Float    @default(0.001)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
}

model AIPromptTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  content   String
  variables String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AIPromptVersion {
  id            String   @id @default(cuid())
  name          String
  versionNumber Int      @default(1)
  systemPrompt  String
  userTemplate  String?
  variables     String[] @default([])
  status        String   @default("PUBLISHED")
  changeLog     String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([name, versionNumber])
}

model AIProviderConfiguration {
  id           String   @id @default(cuid())
  providerName String   @unique
  baseUrl      String?
  apiKey       String?
  isEnabled    Boolean  @default(true)
  priority     Int      @default(1)
  metadata     Json?    @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model AIRecommendation {
  id             String          @id @default(cuid())
  userId         String?
  conversationId String?
  collegeId      String?
  courseId       String?
  scholarshipId  String?
  examId         String?
  matchScore     Float           @default(85.0)
  reasoning      String?
  accepted       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  college        College?        @relation(fields: [collegeId], references: [id])
  AIConversation AIConversation? @relation(fields: [conversationId], references: [id])
  course         Course?         @relation(fields: [courseId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])

  @@index([collegeId])
  @@index([userId])
}

model AISettings {
  id                  String   @id @default("default_ai_settings")
  provider            String   @default("Gemini")
  modelName           String   @default("gemini-1.5-flash")
  apiKey              String?
  temperature         Float    @default(0.3)
  maxTokens           Int      @default(1000)
  topP                Float    @default(0.9)
  frequencyPenalty    Float    @default(0.0)
  presencePenalty     Float    @default(0.0)
  systemPrompt        String   @default("You are Swayam Admission AI Counselor, an expert educational advisor for colleges in India. Provide precise, factual, non-hallucinated guidance using verified knowledge sources.")
  confidenceThreshold Float    @default(0.7)
  escalationEnabled   Boolean  @default(true)
  autoLeadCreation    Boolean  @default(true)
  autoLeadScoring     Boolean  @default(true)
  ragEnabled          Boolean  @default(true)
  topKChunks          Int      @default(5)
  rateLimitPerMin     Int      @default(30)
  dailyCostCap        Float?   @default(100.0)
  isEnabled           Boolean  @default(true)
  welcomeMessage      String?  @default("Hi there! 👋 I am the Swayam Admission AI Counselor. How can I help you with colleges, courses, or admissions today?")
  suggestedChips      String[] @default(["Top Colleges in Bihar", "B.Tech under ₹2L", "Compare Colleges", "Talk to Counselor"])
  counselorPhone      String?  @default("+919000000000")
  counselorWhatsapp   String?  @default("+919000000000")
  counselorWorkingHours String? @default("9:00 AM – 7:00 PM IST (Mon–Sat)")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}

model AITrainingJob {
  id            String    @id @default(cuid())
  jobType       String    @default("RAG_REINDEX")
  status        String    @default("COMPLETED")
  processedDocs Int       @default(0)
  totalChunks   Int       @default(0)
  logs          String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([status])
}

model AIUsage {
  id               String   @id @default(cuid())
  userId           String?
  conversationId   String?
  provider         String   @default("Gemini")
  model            String   @default("gemini-1.5-flash")
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCost    Float    @default(0.0)
  latencyMs        Int      @default(0)
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([provider, model])
}

model AIWorkflow {
  id                  String                @id @default(cuid())
  name                String
  trigger             String
  actions             Json
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now()) @updatedAt
  AIWorkflowExecution AIWorkflowExecution[]
}

model AIWorkflowExecution {
  id         String     @id @default(cuid())
  workflowId String
  status     String     @default("COMPLETED")
  logs       String?
  executedAt DateTime   @default(now())
  AIWorkflow AIWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id         String      @id @default(cuid())
  userId     String?
  eventType  String
  entityType EntityType?
  entityId   String?
  metadata   Json?
  createdAt  DateTime    @default(now())
  User       User?       @relation(fields: [userId], references: [id])

  @@index([eventType, entityType])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  content   String
  type      String
  publishAt DateTime?
  expireAt  DateTime?
  status    String    @default("DRAFT")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
}

model Application {
  id                    String                     @id @default(cuid())
  applicationId         String                     @unique
  userId                String
  collegeId             String?
  courseId              String
  counselorId           String?
  status                ApplicationStatus          @default(NEW)
  remarks               String?
  admissionYear         Int?
  paymentStatus         PaymentStatus              @default(PENDING)
  documentsVerified     Boolean                    @default(false)
  applicationDate       DateTime                   @default(now())
  approvedDate          DateTime?
  rejectedDate          DateTime?
  branchId              String?
  branchName            String?
  applicationNumber     String?                    @unique
  submittedAt           DateTime?
  submittedByActorId    String?
  lastEditedById        String?
  formData              Json?
  completionPercentage  Int                        @default(0)
  declarationAccepted   Boolean                    @default(false)
  declarationAcceptedAt DateTime?
  termsVersion          String?                    @default("v1.0")
  submissionDestination String?                    @default("INTERNAL")
  correctionSection     String?
  correctionReason      String?
  withdrawalReason      String?
  academicSessionId     String?
  offeringId            String?
  reviewerId            String?
  reviewAssignedAt      DateTime?
  reviewStartedAt       DateTime?
  approvedById          String?
  rejectedById          String?
  rejectionReason       String?
  rejectionCategory     String?
  publicRejectionReason String?
  decisionNotes         String?
  reopenedAt            DateTime?
  reopenedById          String?
  reopenReason          String?
  reviewPriority        String?                    @default("NORMAL")
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @default(now()) @updatedAt
  college               College?                   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  counselor             User?                      @relation("Application_counselorIdToUser", fields: [counselorId], references: [id])
  reviewer              User?                      @relation("Application_reviewerIdToUser", fields: [reviewerId], references: [id])
  approvedBy            User?                      @relation("Application_approvedByIdToUser", fields: [approvedById], references: [id])
  rejectedBy            User?                      @relation("Application_rejectedByIdToUser", fields: [rejectedById], references: [id])
  offering              CollegeOffering?           @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  course                Course                     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  branch                CourseBranch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user                  User                       @relation("Application_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)
  timeline              ApplicationTimeline[]
  documents             Document[]
  payments              Payment[]
  PaymentRequest        PaymentRequest[]
  collegeSelections     StudentCollegeSelection[]
  confirmationTokens    CollegeConfirmationToken[]
  reporting             CollegeReporting?
  enrollment            StudentEnrollment?
  collegeReviews        CollegeReview[]
  counselorReviews      CounselorReview[]
  studentReports        StudentCollegeReport[]
  invoices              Invoice[]
  receipts              Receipt[]
  crmActivities         CrmActivity[]
  tasks                 Task[]
  conversations         Conversation[]

  @@index([branchId])
  @@index([counselorId])
  @@index([reviewerId])
  @@index([offeringId])
  @@index([status, paymentStatus])
}

model ApplicationTimeline {
  id            String             @id @default(cuid())
  applicationId String
  userId        String?
  action        String
  oldStatus     ApplicationStatus?
  newStatus     ApplicationStatus?
  remarks       String?
  createdAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  user          User?              @relation(fields: [userId], references: [id])

  @@index([applicationId])
}

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  action          String
  entityId        String?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime @default(now())
  avatar          String?
  browser         String?
  changes         Json?
  city            String?
  country         String?  @default("India")
  description     String?
  deviceType      String?
  email           String?
  endpoint        String?
  entityName      String?
  entityType      String?
  executionTime   Int?     @default(0)
  latitude        Float?
  longitude       Float?
  module          String   @default("SYSTEM")
  newData         Json?
  oldData         Json?
  operatingSystem String?
  requestId       String?
  requestMethod   String?
  roleId          String?
  sessionId       String?
  severity        String   @default("INFO")
  state           String?
  status          String   @default("SUCCESS")
  userName        String?
  entity          String?
  newValue        Json?
  oldValue        Json?
  positionId      String?
  positionCode    String?
  companyEmail    String?
  targetUserId    String?
  User            User?    @relation(fields: [userId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([module])
  @@index([severity])
  @@index([status])
  @@index([userId])
}

model Banner {
  id           String    @id @default(cuid())
  title        String?
  subtitle     String?
  image        String?
  imageUrl     String?
  videoUrl     String?
  mediaType    String    @default("IMAGE") // IMAGE, VIDEO
  buttonText   String?
  buttonUrl    String?
  openInNewTab Boolean   @default(false)
  type         String    @default("BANNER")
  slot         String    @default("HOME_HERO_VIDEO")
  priority     Int       @default(0)
  sortOrder    Int       @default(0)
  startDate    DateTime?
  endDate      DateTime?
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE, DRAFT
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([slot])
  @@index([status])
  @@index([isActive])
}

model Blog {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  category         String
  authorId         String?
  thumbnail        String?
  content          String
  tags             String[]
  seoTitle         String?
  seoDescription   String?
  status           String         @default("DRAFT")
  readingTime      Int?           @default(5)
  featured         Boolean        @default(false)
  relatedBlogs     String[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  aiReadinessScore Int            @default(80)
  aiSummary        String?
  canonicalUrl     String?
  career           String?
  city             String?
  collegeId        String?
  courseId         String?
  createdBy        String?
  deletedAt        DateTime?
  entities         Json?
  examId           String?
  excerpt          String?
  faqs             Json?
  featuredImage    String?
  gallery          String[]
  geoScore         Int            @default(80)
  governmentScheme String?
  isIndexed        Boolean        @default(true)
  keyTakeaways     String[]
  likes            Int            @default(0)
  metaRobots       String?        @default("index, follow")
  openGraph        Json?
  publishedAt      DateTime?
  readabilityScore Int            @default(85)
  scholarshipId    String?
  seoKeywords      String[]
  seoScore         Int            @default(80)
  shares           Int            @default(0)
  state            String?
  studyMaterialId  String?
  tldr             String?
  twitterCard      Json?
  updatedBy        String?
  views            Int            @default(0)
  author           User?          @relation(fields: [authorId], references: [id])
  college          College?       @relation(fields: [collegeId], references: [id])
  course           Course?        @relation(fields: [courseId], references: [id])
  exam             Exam?          @relation(fields: [examId], references: [id])
  scholarship      Scholarship?   @relation(fields: [scholarshipId], references: [id])
  StudyMaterial    StudyMaterial? @relation(fields: [studyMaterialId], references: [id])
  revisions        BlogRevision[]
  FAQ              FAQ[]

  // Career & Admission Guides ERP Attributes
  guideType             String         @default("CAREER")
  educationLevel        String?
  stream                String?
  specialization        String?
  careerPath            String?
  skills                String[]       @default([])
  eligibility           String?
  entranceExams         String[]       @default([])
  salaryRange           String?
  averageSalary         String?
  growthRate            String?
  higherStudyOptions    String[]       @default([])
  jobRoles              String[]       @default([])
  govPrivatePaths       String?
  admissionProcess      String?
  applicationProcess    String?
  requiredDocuments     String[]       @default([])
  admissionStages       Json?
  feesInfo              String?
  counsellingInfo       String?
  scholarshipInfo       String?
  stateSchemesInfo      String?
  importantTimelines    Json?
  prepGuidance          String?
  relatedCourseIds      String[]       @default([])
  relatedCollegeIds     String[]       @default([])
  relatedExamIds        String[]       @default([])
  relatedScholarshipIds String[]       @default([])
  stateId               String?
  districtId            String?
  savedGuides           SavedGuide[]

  @@index([category, status])
  @@index([collegeId, courseId, examId, scholarshipId])
  @@index([slug])
  @@index([status, featured])
  @@index([guideType, status])
  @@index([educationLevel, stream])
}

model BlogRevision {
  id             String   @id @default(cuid())
  blogId         String
  versionNumber  Int
  title          String
  content        String
  excerpt        String?
  seoTitle       String?
  seoDescription String?
  faqs           Json?
  keyTakeaways   String[]
  createdBy      String?
  createdAt      DateTime @default(now())
  Blog           Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
}

model SavedGuide {
  id        String   @id @default(cuid())
  userId    String
  guideId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guide     Blog     @relation(fields: [guideId], references: [id], onDelete: Cascade)

  @@unique([userId, guideId])
  @@index([userId])
  @@index([guideId])
}

model BrandingSetting {
  id             String   @id @default("default_branding_setting")
  logo           String?
  darkLogo       String?
  lightLogo      String?
  favicon        String?
  appIcon        String?
  invoiceLogo    String?
  receiptLogo    String?
  emailLogo      String?
  emailHeader    String?
  emailFooter    String?
  watermark      String?
  primaryColor   String   @default("#4A7B5B")
  secondaryColor String   @default("#0EA5E9")
  accentColor    String   @default("#F0AE1A")
  successColor   String   @default("#10B981")
  warningColor   String   @default("#F59E0B")
  dangerColor    String   @default("#DC2626")
  typography     String   @default("Inter, sans-serif")
  fontFamily     String   @default("Inter")
  borderRadius   String   @default("12px")
  buttonStyle    String   @default("Rounded")
  cardStyle      String   @default("Bordered")
  navbarStyle    String   @default("Sticky")
  footerStyle    String   @default("Standard")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model Campaign {
  id                 String             @id @default(cuid())
  campaignName       String
  campaignCode       String             @unique
  slug               String?            @unique
  description        String?
  objective          String?
  campaignType       CampaignType       @default(ADMISSION_CAMPAIGN)
  source             String             @default("WEBSITE")
  medium             String?            @default("CPC")
  channel            String?            @default("ONLINE")
  status             CampaignStatus     @default(ACTIVE)
  startDate          DateTime?
  endDate            DateTime?
  dailyBudget        Float              @default(0)
  totalBudget        Float              @default(0)
  spentAmount        Float              @default(0)
  expectedLeads      Int                @default(0)
  expectedAdmissions Int                @default(0)
  expectedRevenue    Float              @default(0)
  actualLeads        Int                @default(0)
  actualAdmissions   Int                @default(0)
  actualRevenue      Float              @default(0)
  impressions        Int                @default(0)
  clicks             Int                @default(0)
  ctr                Float              @default(0)
  cpc                Float              @default(0)
  cpl                Float              @default(0)
  roi                Float              @default(0)
  conversionRate     Float              @default(0)
  featured           Boolean            @default(false)
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt
  leads              CampaignLead[]
  landingPages       LandingPage[]
  referrals          ReferralCampaign[]

  @@index([source, channel])
  @@index([status, campaignType])
}

model CampaignLead {
  id          String   @id @default(cuid())
  campaignId  String
  leadId      String
  source      String?
  medium      String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  status      String   @default("NEW")
  converted   Boolean  @default(false)
  admitted    Boolean  @default(false)
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([campaignId])
  @@index([leadId])
}

model Career {
  id                    String         @id @default(cuid())
  careerName            String
  slug                  String         @unique
  stream                String
  requiredQualification String?
  averageSalary         Float?
  growthRate            String?
  futureScope           String?
  industries            String[]
  skills                String[]
  roadmap               String?
  relatedCareers        String[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @default(now()) @updatedAt
  courses               CareerCourse[]
}

model CareerCourse {
  careerId String
  courseId String
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([careerId, courseId])
}

model College {
  id                     String                     @id @default(cuid())
  name                   String
  slug                   String                     @unique
  shortDescription       String?
  fullDescription        String?
  logo                   String?
  banner                 String?
  brochureUrl            String?
  establishedYear        Int?
  ownership              CollegeOwnership           @default(PRIVATE)
  type                   CollegeType                @default(PRIVATE)
  university             String?
  accreditation          String?
  approvals              String[]
  ranking                Int?
  nirfRanking            Int?
  naacGrade              String?
  city                   String
  state                  String
  stateId                String?
  districtId             String?
  stateRelation          State?                     @relation(fields: [stateId], references: [id], onDelete: SetNull)
  districtRelation       District?                  @relation(fields: [districtId], references: [id], onDelete: SetNull)
  address                String?
  pincode                String?
  latitude               Float?
  longitude              Float?
  website                String?
  email                  String?
  phone                  String?
  whatsapp               String?
  placementPercentage    Float?
  highestPackage         Float?
  averagePackage         Float?
  hostelAvailable        Boolean                    @default(false)
  transportAvailable     Boolean                    @default(false)
  scholarshipAvailable   Boolean                    @default(false)
  applicationFee         Float?
  featured               Boolean                    @default(false)
  verified               Boolean                    @default(false)
  status                 CollegeStatus              @default(DRAFT)
  seoTitle               String?
  seoDescription         String?
  seoKeywords            String[]                   @default([])
  rating                 Float?                     @default(4.2)
  contactPerson          String?
  boysHostelAvailable    Boolean                    @default(false)
  girlsHostelAvailable   Boolean                    @default(false)
  hostelFee              String?
  hostelFacilities       String[]                   @default([])
  messInfo               String?
  otherFacilities        String[]                   @default([])
  medianPackage          Float?
  placementCompanies     String[]                   @default([])
  placementInfo          String?
  placementYear          String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @default(now()) @updatedAt
  approvalFlowConfig     Json?                      @default("[\"COUNSELOR\", \"ACCOUNTS_MANAGER\", \"DIRECTOR\"]")
  invoicePrefix          String?                    @default("SA-INV")
  paymentMode            String                     @default("HYBRID")
  receiptPrefix          String?                    @default("SA-REC")
  verificationRules      Json?                      @default("{\"autoVerify\": false, \"utrRequired\": false, \"manualVerify\": true, \"amountEditable\": false, \"screenshotRequired\": true, \"invoiceAutoGenerate\": true, \"receiptAutoGenerate\": true}")
  hybridFeeHeadMapping   Json?                      @default("{\"HOSTEL_FEE\": \"DIRECT_COLLEGE\", \"SEMESTER_FEE\": \"DIRECT_COLLEGE\", \"ADMISSION_FEE\": \"DIRECT_COLLEGE\", \"TRANSPORT_FEE\": \"PLATFORM\", \"COUNSELING_FEE\": \"PLATFORM\", \"EXAMINATION_FEE\": \"PLATFORM\", \"REGISTRATION_FEE\": \"PLATFORM\", \"SECURITY_DEPOSIT\": \"DIRECT_COLLEGE\"}")
  paymentRules           Json?                      @default("{\"maxAmount\": 1000000, \"minAmount\": 100, \"allowPartial\": true, \"lateFeePerDay\": 100, \"autoExpireDays\": 30, \"gracePeriodDays\": 5, \"allowInstallments\": true}")
  platformGateways       Json?                      @default("{\"paytm\": false, \"stripe\": false, \"phonepe\": true, \"cashfree\": false, \"razorpay\": true}")
  AIRecommendation       AIRecommendation[]
  applications           Application[]
  Blog                   Blog[]
  bankAccounts           CollegeBankAccount[]
  CollegeFAQ             CollegeFAQ[]
  gallery                CollegeGallery[]
  reviews                CollegeReview[]
  courses                Course[]
  Document               Document[]
  DocumentRequirement    DocumentRequirement[]
  faqs                   FAQ[]
  FeeHead                FeeHead[]
  leads                  Lead[]
  Payment                Payment[]
  PaymentRequest         PaymentRequest[]
  SavedRecommendation    SavedRecommendation[]
  StudyMaterial          StudyMaterial[]
  collegeRecommendations CollegeRecommendation[]
  collegeShortlists      CollegeShortlist[]
  collegeSelections      StudentCollegeSelection[]
  confirmationTokens     CollegeConfirmationToken[]
  reportings             CollegeReporting[]
  enrollments            StudentEnrollment[]
  confidentialComplaints ConfidentialComplaint[]
  rankingResults         CollegeRankingResult[]
  staffUsers             User[]                     @relation("CollegeStaff")
  offerings              CollegeOffering[]
  collegeDocuments       CollegeDocument[]
  changeRequests         CollegeChangeRequest[]
  verifiedFactors        CollegeVerifiedFactor[]
  studentReports         StudentCollegeReport[]
  rankingSurveys         RankingSurvey[]
  rankingDataPoints      RankingDataPoint[]
  invoices               Invoice[]
  receipts               Receipt[]
  reconciliations        PaymentReconciliation[]

  @@index([nirfRanking])
  @@index([ownership, type])
  @@index([slug])
  @@index([state, city])
  @@index([stateId])
  @@index([districtId])
  @@index([status, featured])
}

model CollegeBankAccount {
  id                String              @id @default(cuid())
  collegeId         String
  bankName          String
  accountHolder     String
  accountNumber     String
  ifscCode          String
  branchName        String?
  upiId             String?
  qrCodeUrl         String?
  instructions      String?
  minAmount         Float?
  maxAmount         Float?
  acceptedMethods   String[]
  isActive          Boolean             @default(true)
  isDefault         Boolean             @default(false)
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @default(now()) @updatedAt
  category          String              @default("ADMISSION")
  College           College             @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  Payment           Payment[]
  PaymentRequest    PaymentRequest[]
  PaymentAllocation PaymentAllocation[]

  @@index([collegeId])
  @@index([isActive])
}

model CollegeFAQ {
  id        String   @id @default(cuid())
  collegeId String
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  College   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model CollegeGallery {
  id        String   @id @default(cuid())
  collegeId String
  imageUrl  String
  caption   String?
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())
  College   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model CollegeReview {
  id                String             @id @default(cuid())
  collegeId         String
  userId            String
  applicationId     String?
  enrollmentId      String?
  courseId          String?
  branchId          String?
  academicSessionId String?
  rating            Float
  title             String?
  content           String?
  isVerifiedStudent Boolean            @default(false)
  status            String             @default("PENDING_MODERATION")
  moderationReason  String?
  moderatedById     String?
  moderatedAt       DateTime?
  isApproved        Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  college           College            @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  application       Application?       @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  enrollment        StudentEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  moderatedBy       User?              @relation("CollegeReview_moderatedBy", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([collegeId])
  @@index([userId])
  @@index([status])
}

model CounselorReview {
  id               String       @id @default(cuid())
  counselorId      String
  studentId        String
  applicationId    String?
  rating           Float
  title            String?
  comment          String?
  status           String       @default("PUBLISHED")
  moderationReason String?
  moderatedById    String?
  moderatedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt
  counselor        User         @relation("CounselorReview_counselor", fields: [counselorId], references: [id], onDelete: Cascade)
  student          User         @relation("CounselorReview_student", fields: [studentId], references: [id], onDelete: Cascade)
  application      Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  moderatedBy      User?        @relation("CounselorReview_moderatedBy", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([counselorId])
  @@index([studentId])
  @@index([status])
}

model SupportReview {
  id             String   @id @default(cuid())
  ticketId       String?
  studentId      String
  supportAgentId String?
  rating         Float
  comment        String?
  status         String   @default("PUBLISHED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  student        User     @relation("SupportReview_student", fields: [studentId], references: [id], onDelete: Cascade)
  supportAgent   User?    @relation("SupportReview_supportAgent", fields: [supportAgentId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([ticketId])
}

model ConfidentialComplaint {
  id                 String    @id @default(cuid())
  studentId          String
  collegeId          String?
  category           String
  severity           String    @default("HIGH")
  description        String
  evidenceUrl        String?
  status             String    @default("RECEIVED")
  investigationNotes String?
  assignedToId       String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt
  student            User      @relation("Complaint_student", fields: [studentId], references: [id], onDelete: Cascade)
  college            College?  @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  assignedTo         User?     @relation("Complaint_assignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([collegeId])
  @@index([status])
}

model RankingEdition {
  id                    String                 @id @default(cuid())
  year                  Int                    @unique
  title                 String
  algorithmVersion      String                 @default("v1.0")
  status                String                 @default("DRAFT") // DRAFT, DATA_COLLECTION, SURVEY_ACTIVE, ANALYSIS, REPORT_GENERATED, UNDER_REVIEW, CHANGES_REQUESTED, APPROVED, SCHEDULED, PUBLISHED, ARCHIVED
  weightsConfig         Json
  minReviewThreshold    Int                    @default(3)
  dataCutoffDate        DateTime?
  dataCollectionStart   DateTime?
  dataCollectionEnd     DateTime?
  surveyStart           DateTime?
  surveyEnd             DateTime?
  reviewStart           DateTime?
  reviewEnd             DateTime?
  analysisStart         DateTime?
  reportGeneratedAt     DateTime?
  calculatedAt          DateTime?
  calculatedById        String?
  approvedAt            DateTime?
  approvedById          String?
  publishedAt           DateTime?
  publishedById         String?
  unpublishReason       String?
  methodologyId         String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @default(now()) @updatedAt
  calculatedBy          User?                  @relation("Ranking_calculatedBy", fields: [calculatedById], references: [id], onDelete: SetNull)
  approvedBy            User?                  @relation("Ranking_approvedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  publishedBy           User?                  @relation("Ranking_publishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  methodology           RankingMethodology?    @relation(fields: [methodologyId], references: [id], onDelete: SetNull)
  results               CollegeRankingResult[]
  surveys               RankingSurvey[]
  dataPoints            RankingDataPoint[]
  annualReports         RankingAnnualReport[]

  @@index([year])
  @@index([status])
}

model CollegeRankingResult {
  id                  String         @id @default(cuid())
  editionId           String
  collegeId           String
  rank                Int
  score               Float
  percentile          Float?
  tier                String?
  verifiedReviewCount Int            @default(0)
  averageReviewRating Float?
  factorBreakdown     Json?
  dataProvenance      Json?
  confidenceScore     Float          @default(85.0)
  confidenceLevel     String         @default("HIGH") // HIGH, MEDIUM, LOW
  pillarScores        Json?          // { academicExcellence, placementCareer, studentDemandExperience, infrastructureCampus, locationConnectivity, hostelLivingExperience, dailyConvenienceScore, safetyHealthcare, affordabilityRoi, trustTransparency }
  rawMetrics          Json?
  normalizedMetrics   Json?
  previousRank        Int?
  rankChange          Int?           @default(0)
  scoreChange         Float?         @default(0.0)
  movement            String         @default("STABLE") // IMPROVED, DECLINED, STABLE, NEW_ENTRY
  specialBadges       Json?          @default("[]")
  strengths           Json?          @default("[]")
  gaps                Json?          @default("[]")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now()) @updatedAt
  edition             RankingEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  college             College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([editionId, collegeId])
  @@index([editionId, rank])
  @@index([collegeId])
}

model RankingMethodology {
  id            String           @id @default(cuid())
  version       String           @unique // e.g. "v1.0.0"
  name          String
  description   String?
  status        String           @default("ACTIVE") // ACTIVE, DRAFT, SUPERSEDED
  pillarsConfig Json             // 9 pillars, weights, subcriteria
  rulesConfig   Json             // normalization, confidence, tie-break rules
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  createdBy     User?            @relation("Methodology_createdBy", fields: [createdById], references: [id], onDelete: SetNull)
  editions      RankingEdition[]

  @@index([version])
  @@index([status])
}

model StudentCollegeReport {
  id                      String             @id @default(cuid())
  studentId               String
  collegeId               String
  courseId                String?
  applicationId           String?
  enrollmentId            String?
  rankingYear             Int                @default(2026)
  title                   String?
  detailedReview          String?
  evidenceUrls            Json?              @default("[]")
  isVerifiedStudent       Boolean            @default(false)
  status                  String             @default("PENDING") // PENDING, VERIFIED, PUBLISHED, REJECTED, FLAGGED, ARCHIVED
  academicRating          Float?
  placementRating         Float?
  studentDemandRating     Float?
  infrastructureRating    Float?
  connectivityRating      Float?
  hostelLivingRating      Float?
  dailyConvenienceRating  Float?
  safetyHealthcareRating  Float?
  affordabilityRoiRating  Float?
  trustTransparencyRating Float?
  overallRating           Float              @default(4.0)
  moderatedById           String?
  moderatedAt             DateTime?
  moderationReason        String?
  ipAddress               String?
  userAgent               String?
  submissionFingerprint   String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @default(now()) @updatedAt
  student                 User               @relation("StudentReport_student", fields: [studentId], references: [id], onDelete: Cascade)
  college                 College            @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course                  Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  application             Application?       @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  enrollment              StudentEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  moderatedBy             User?              @relation("StudentReport_moderatedBy", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([collegeId])
  @@index([rankingYear])
  @@index([status])
}

model RankingSurvey {
  id            String                  @id @default(cuid())
  rankingYear   Int                     @default(2026)
  editionId     String?
  collegeId     String
  templateName  String                  @default("SWAYAM_STANDARD_9_PILLAR_V1")
  surveyorId    String?
  status        String                  @default("ASSIGNED") // ASSIGNED, IN_PROGRESS, SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED
  overallScore  Float?
  scheduledDate DateTime?
  conductedAt   DateTime?
  submittedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNotes   String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @default(now()) @updatedAt
  edition       RankingEdition?         @relation(fields: [editionId], references: [id], onDelete: SetNull)
  college       College                 @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  surveyor      User?                   @relation("RankingSurvey_surveyor", fields: [surveyorId], references: [id], onDelete: SetNull)
  reviewedBy    User?                   @relation("RankingSurvey_reviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  responses     RankingSurveyResponse[]

  @@index([rankingYear])
  @@index([collegeId])
  @@index([status])
}

model RankingSurveyResponse {
  id           String        @id @default(cuid())
  surveyId     String
  pillar       String        // ACADEMIC_EXCELLENCE, PLACEMENT_CAREER, etc.
  criterion    String
  metric       String
  score        Float
  observation  String?
  evidenceUrls Json?         @default("[]")
  verified     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  survey       RankingSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([pillar])
}

model RankingDataPoint {
  id               String          @id @default(cuid())
  collegeId        String
  rankingYear      Int             @default(2026)
  editionId        String?
  pillar           String          // ACADEMIC_EXCELLENCE, PLACEMENT_CAREER, etc.
  metricKey        String
  metricName       String
  rawValue         String
  normalizedValue  Float
  sourceType       String          @default("SWAYAM_VERIFIED") // SWAYAM_VERIFIED, SWAYAM_PLATFORM_DATA, STUDENT_VERIFIED, STUDENT_REPORT, SWAYAM_MANUAL_SURVEY, COLLEGE_VERIFIED, COLLEGE_SELF_REPORTED, PUBLIC_VERIFIED, SYSTEM_CALCULATED
  evidenceUrl      String?
  status           String          @default("VERIFIED") // PENDING, SUBMITTED, UNDER_REVIEW, VERIFIED, REJECTED, FLAGGED, EXPIRED
  confidenceWeight Float           @default(1.0)
  collectedAt      DateTime        @default(now())
  verifiedAt       DateTime?
  verifiedById     String?
  validUntil       DateTime?
  verifierNotes    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  college          College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  edition          RankingEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)
  verifiedBy       User?           @relation("DataPoint_verifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([collegeId])
  @@index([rankingYear])
  @@index([pillar])
  @@index([status])
}

model RankingAnnualReport {
  id                 String         @id @default(cuid())
  rankingYear        Int            @unique
  editionId          String
  methodologyVersion String         @default("v1.0.0")
  reportVersion      Int            @default(1)
  title              String
  status             String         @default("GENERATED") // DRAFT, GENERATING, GENERATED, UNDER_REVIEW, CHANGES_REQUESTED, APPROVED, SCHEDULED, PUBLISHED, ARCHIVED
  executiveSummary   String?
  methodologySummary String?
  keyFindings        Json?          @default("[]")
  limitations        String?
  fullReportJson     Json?          // Full 11 sections
  generatedById      String?
  generatedAt        DateTime       @default(now())
  approvedById       String?
  approvedAt         DateTime?
  publishedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt
  edition            RankingEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  generatedBy        User?          @relation("AnnualReport_generatedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  approvedBy         User?          @relation("AnnualReport_approvedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([rankingYear])
  @@index([status])
}

model CollegeVerifiedFactor {
  id             String    @id @default(cuid())
  collegeId      String
  factorCategory String
  factorName     String
  score          Float
  sourceType     String    @default("SWAYAM_VERIFIED")
  evidenceUrl    String?
  verifierNotes  String?
  verifiedById   String?
  validUntil     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  college        College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  verifiedBy     User?     @relation("Factor_verifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([collegeId])
  @@index([factorCategory])
}

model CounselorActivityLog {
  id          String           @id @default(cuid())
  counselorId String
  action      String
  entityType  String?
  entityId    String?
  description String
  metadata    Json?
  createdAt   DateTime         @default(now())
  counselor   CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)

  @@index([counselorId])
  @@index([createdAt])
}

model CounselorAssignment {
  id          String   @id @default(cuid())
  leadId      String
  counselorId String
  assignedBy  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  assigner    User?    @relation("CounselorAssignment_assignedByToUser", fields: [assignedBy], references: [id])
  counselor   User     @relation("CounselorAssignment_counselorIdToUser", fields: [counselorId], references: [id], onDelete: Cascade)
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model CounselorAttendance {
  id           String           @id @default(cuid())
  counselorId  String
  date         DateTime         @default(now())
  status       String           @default("ONLINE")
  checkIn      DateTime         @default(now())
  checkOut     DateTime?
  workingHours Float            @default(0)
  ipAddress    String?
  device       String?
  notes        String?
  createdAt    DateTime         @default(now())
  counselor    CounselorProfile @relation(fields: [counselorId], references: [id], onDelete: Cascade)

  @@index([counselorId, date])
}

model CounselorCommission {
  id             String           @id @default(cuid())
  counselorId    String
  studentId      String?
  applicationId  String?
  paymentId      String?
  amount         Float            @default(0)
  commissionRate Float            @default(5.0)
  status         String           @default("PENDING")
  payoutDate     DateTime?
  invoiceNumber  String?
  notes          String?
