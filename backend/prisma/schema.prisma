model Position {
  id                       String   @id @default(cuid())
  code                     String   @unique // e.g. SC-MAD-001, FIN-PAT-001
  title                    String // e.g. Senior Counselor — Madhubani
  description              String?
  departmentId             String
  unitId                   String?
  roleId                   String?
  companyEmail             String   @unique // e.g. senior.madhubani@swayamadmission.com
  emailStatus              String   @default("ACTIVE") // ACTIVE | SUSPENDED | DISABLED | RETIRED
  positionStatus           String   @default("ACTIVE") // ACTIVE | VACANT | SUSPENDED | RETIRED
  stateId                  String?
  districtId               String?
  isMultiHolder            Boolean  @default(false)
  selfServicePasswordReset Boolean  @default(false)
  createdById              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @default(now()) @updatedAt

  department             Department                 @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  unit                   Team?                      @relation(fields: [unitId], references: [id], onDelete: SetNull)
  roleEntity             RoleEntity?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  state                  State?                     @relation(fields: [stateId], references: [id], onDelete: SetNull)
  district               District?                  @relation(fields: [districtId], references: [id], onDelete: SetNull)
  createdBy              User?                      @relation("Position_createdByIdToUser", fields: [createdById], references: [id])
  assignments            PositionAssignment[]
  assignedLeads          Lead[]                     @relation("Lead_assignedPositionIdToPosition")
  leadAssignments        LeadAssignment[]           @relation("LeadAssignment_assignedPositionIdToPosition")
  assignedStaffRequests  StaffRegistrationRequest[] @relation("StaffRegistrationRequest_assignedPositionIdToPosition")
  requestedStaffRequests StaffRegistrationRequest[] @relation("StaffRegistrationRequest_requestedPositionIdToPosition")

  @@index([code])
  @@index([companyEmail])
  @@index([departmentId])
  @@index([unitId])
  @@index([roleId])
  @@index([stateId])
  @@index([districtId])
  @@index([positionStatus])
}

model PositionAssignment {
  id                    String    @id @default(cuid())
  positionId            String
  userId                String
  status                String    @default("ACTIVE") // ACTIVE | ENDED | TRANSFERRED | RESIGNED | SUSPENDED
  joinedAt              DateTime  @default(now())
  endedAt               DateTime?
  changeReason          String? // INITIAL_ASSIGNMENT | RESIGNATION | TRANSFER | PROMOTION | REPLACEMENT | TERMINATION | SECURITY_REVOCATION
  assignedById          String?
  approvedById          String?
  mailboxHandoverStatus String    @default("GRANTED") // GRANTED | REVOKED | PENDING_REVIEW | RETAINED_ARCHIVE
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("PositionAssignment_assignedByIdToUser", fields: [assignedById], references: [id])
  approvedBy User?    @relation("PositionAssignment_approvedByIdToUser", fields: [approvedById], references: [id])

  @@index([positionId, status])
  @@index([userId, status])
  @@index([joinedAt])
}

model StaffKycDocument {
  id              String    @id @default(cuid())
  userId          String
  documentType    String // AADHAAR | PAN | RESUME | EXPERIENCE_CERTIFICATE | OTHER_KYC
  documentNumber  String? // Masked e.g. XXXX-XXXX-1234 or ABCDE****F
  fileUrl         String
  fileName        String
  fileSize        Int?
  mimeType        String?
  status          String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  rejectionReason String?
  verifiedById    String?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  user       User  @relation("StaffKycDocument_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("StaffKycDocument_verifiedByIdToUser", fields: [verifiedById], references: [id])

  @@index([userId])
  @@index([status])
  @@index([documentType])
}

model StaffRegistrationRequest {
  id                   String    @id @default(cuid())
  userId               String
  requestedRoleSlug    String // senior-counselor | counselor
  requestedPositionId  String?
  requestedStateId     String?
  requestedDistrictId  String?
  referralCode         String?
  personalEmail        String
  personalMobile       String
  fullName             String
  kycStatus            String    @default("NOT_SUBMITTED") // NOT_SUBMITTED | PENDING | VERIFIED | REJECTED
  mobileVerifiedAt     DateTime?
  emailVerifiedAt      DateTime?
  approvalStatus       String    @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason      String?
  assignedPositionId   String?
  assignedRoleId       String?
  assignedDepartmentId String?
  reviewedById         String?
  reviewedAt           DateTime?
  submittedAt          DateTime  @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @default(now()) @updatedAt

  user               User        @relation("StaffRegistrationRequest_userIdToUser", fields: [userId], references: [id], onDelete: Cascade)
  requestedPosition  Position?   @relation("StaffRegistrationRequest_requestedPositionIdToPosition", fields: [requestedPositionId], references: [id])
  assignedPosition   Position?   @relation("StaffRegistrationRequest_assignedPositionIdToPosition", fields: [assignedPositionId], references: [id])
  assignedRole       RoleEntity? @relation(fields: [assignedRoleId], references: [id])
