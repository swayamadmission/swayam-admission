  campaignId              String?
  status                  String                 @default("LEAD_CREATED") // CLICKED | LEAD_CREATED | REGISTERED | APPLICATION_SUBMITTED | ADMISSION_APPROVED | PAYMENT_COMPLETED | ENROLLED | EXPIRED | INVALID
  fraudStatus             String                 @default("CLEAN") // CLEAN | FLAGGED_FOR_REVIEW | REJECTED | APPROVED
  fraudReason             String?
