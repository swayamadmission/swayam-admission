  requestedState     State?      @relation(fields: [requestedStateId], references: [id])
  requestedDistrict  District?   @relation(fields: [requestedDistrictId], references: [id])
  reviewedBy         User?       @relation("StaffRegistrationRequest_reviewedByIdToUser", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([approvalStatus])
  @@index([kycStatus])
  @@index([requestedRoleSlug])
}

