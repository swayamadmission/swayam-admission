  maxDiscountAmount    Float?             // Cap for percentage discounts e.g. 2000
  minTransactionAmount Float              @default(0.0)
  applicableScope      String             @default("ALL") // ALL | COUNSELLING_FEE | APPLICATION_FEE | STUDY_MATERIAL_FEE | TUITION_FEE | SECURITY_DEPOSIT | REGISTRATION_FEE | ADMISSION_FEE | EXAMINATION_FEE | ENROLLMENT_FEE | HOSTEL_FEE | MISC_FEE
