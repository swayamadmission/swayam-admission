  updatedAt               DateTime               @default(now()) @updatedAt

  referrerStudent         User                   @relation("StudentReferral_referrer", fields: [referrerStudentId], references: [id], onDelete: Cascade)
  referredLead            Lead?                  @relation("StudentReferral_referredLead", fields: [referredLeadId], references: [id], onDelete: SetNull)
  referredStudent         User?                  @relation("StudentReferral_referredStudent", fields: [referredStudentId], references: [id], onDelete: SetNull)
  rewards                 ReferralRewardLedger[]

  @@index([referralCode])
  @@index([referrerStudentId])
  @@index([referredLeadId])
  @@index([referredStudentId])
  @@index([status])
  @@index([isQualifying])
  @@index([qualificationStatus])
  @@index([fraudStatus])
  @@index([rewardStatus])
  @@index([createdAt])
}

