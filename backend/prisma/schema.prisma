  description        String?
  assignedTo         String
  type               TaskType          @default(OTHER)
  status             TaskStatus        @default(PENDING)
  dueDate            DateTime
  priority           String            @default("MEDIUM")
  relatedTo          String?
  contextType        String            @default("GENERAL") // LEAD, STUDENT, APPLICATION, PAYMENT, REPORTING, ENROLLMENT, GENERAL
  leadId             String?
  studentId          String?
  applicationId      String?
  paymentId          String?
  reportingId        String?
  enrollmentId       String?
  createdById        String?
  completedAt        DateTime?
  completedById      String?
  completionNotes    String?
  completionOutcome  String?
  isEscalated        Boolean           @default(false)
  escalatedAt        DateTime?
  escalatedToId      String?
  escalationReason   String?
  rescheduledFrom    DateTime?
  rescheduledReason  String?
  rescheduledById    String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @default(now()) @updatedAt
  counselorProfileId String?

  User               User              @relation(fields: [assignedTo], references: [id])
  CounselorProfile   CounselorProfile? @relation(fields: [counselorProfileId], references: [id])
  lead               Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  student            User?             @relation("Task_student", fields: [studentId], references: [id], onDelete: Cascade)
  creator            User?             @relation("Task_creator", fields: [createdById], references: [id], onDelete: SetNull)
  completer          User?             @relation("Task_completer", fields: [completedById], references: [id], onDelete: SetNull)
  escalatedTo        User?             @relation("Task_escalatedTo", fields: [escalatedToId], references: [id], onDelete: SetNull)
  application        Application?      @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([assignedTo])
  @@index([leadId])
  @@index([studentId])
  @@index([applicationId])
  @@index([status])
  @@index([dueDate])
  @@index([isEscalated])
}

model CrmActivity {
  id               String       @id @default(cuid())
