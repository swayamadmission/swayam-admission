  qualificationEvidence   Json?
  
  rewardEligibility       String                 @default("PENDING") // PENDING | ELIGIBLE | INELIGIBLE | GRANTED
  rewardAmount            Float                  @default(0.0)
  rewardType              String                 @default("CASH") // CASH | CREDIT | COUPON | FEE_DISCOUNT | BENEFIT
  rewardStatus            String                 @default("UNCLAIMED") // UNCLAIMED | PENDING_APPROVAL | APPROVED | PAID | REVERSED | REJECTED
  overrideReason          String?
  overriddenById          String?
