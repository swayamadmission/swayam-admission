model CommunicationCampaign {
  id                   String                      @id @default(cuid())
  name                 String
  campaignCode         String                      @unique @default(cuid())
  type                 CommCampaignType            @default(PROMOTIONAL)
  status               CommunicationCampaignStatus @default(DRAFT)
  channels             CommunicationChannel[]      @default([IN_APP])
  targetEntity         String                      @default("ALL") // "STUDENT", "LEAD", "STAFF", "ALL"
  audienceId           String?
  audienceFilter       Json                        @default("{}")
  audienceType         CampaignAudienceType        @default(DYNAMIC)
  snapshotRecipientIds Json?
  subject              String?
  title                String
  message              String
  smsBody              String?
  whatsAppTemplateName String?
  whatsAppBody         String?
  emailHtml            String?
  templateId           String?
  templateVersion      Int?                        @default(1)
  scheduledAt          DateTime?
  timezone             String                      @default("Asia/Kolkata")
  sendLock             Boolean                     @default(false)
  totalAudience        Int                         @default(0)
  eligibleCount        Int                         @default(0)
  excludedConsentCount Int                         @default(0)
  invalidContactCount  Int                         @default(0)
  sentCount            Int                         @default(0)
  deliveredCount       Int                         @default(0)
  failedCount          Int                         @default(0)
  skippedCount         Int                         @default(0)
  estimatedCost        Float                       @default(0.0)
  failureReason        String?
  createdById          String?
  approvedById         String?
  sentAt               DateTime?
  completedAt          DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @default(now()) @updatedAt

  deliveries           CommunicationDelivery[]
  template             CommunicationTemplate?      @relation(fields: [templateId], references: [id], onDelete: SetNull)
  savedAudience        SavedAudience?              @relation(fields: [audienceId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([type])
  @@index([audienceId])
  @@index([scheduledAt])
  @@index([createdAt])
}

